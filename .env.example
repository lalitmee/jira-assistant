# Atlassian OAuth (Developer Console → Settings / Authorization)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8888/auth/callback

# Session signing (openssl rand -hex 32)
SESSION_SECRET=

# Local ports (yarn dev)
API_PORT=8888
WEB_ORIGIN=http://localhost:5173

# Docker compose overrides WEB_ORIGIN and ATLASSIAN_REDIRECT_URI to port 8888
