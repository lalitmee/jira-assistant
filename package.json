{
  "name": "jira-assistant",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"yarn workspace @jira-assistant/api dev\" \"yarn workspace @jira-assistant/web dev\"",
    "dev:api": "yarn workspace @jira-assistant/api dev",
    "dev:web": "yarn workspace @jira-assistant/web dev",
    "build": "yarn workspace @jira-assistant/api build && yarn workspace @jira-assistant/web build",
    "start:prod": "zsh scripts/start-prod.zsh",
    "prod": "yarn build && yarn start:prod",
    "test": "yarn workspace @jira-assistant/api test && yarn workspace @jira-assistant/web test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "resolutions": {
    "brace-expansion": "^5.0.12",
    "shell-quote": "^1.11.0"
  }
}
